  "cards": [
    {
      "dot": "cyan",
      "title": "控制与执行",
      "items": [
        "basic_motion 是唯一运动入口：SET / WMOVE / BMOVE / WTRAVEL / BTRAVEL 经 Action 阻塞执行",
        "sim_bridge 承担级联 PID 与 6 推进器推力分配，并发布 6-DOF 状态",
        "真机由 STM32 MCU 经 micro-ROS 顶替 PID 环节，hw_manager 负责心跳与解锁"
      ]
    },
    {
      "dot": "emerald",
      "title": "感知与回传",
      "items": [
        "vision 订阅 sim_bridge 拼接的 4 路双目图像，sim / real 模式切换",
        "position 多帧单目射线交会，用完整 RPY 旋转射线方向",
        "结果以 /perception/objects 同时回传任务层与导航层"
      ]
    },
    {
      "dot": "violet",
      "title": "仓库支撑",
      "items": [
        "uv_msgs / zit6_interfaces 定义 BasicMotion.action 与全部 msg / srv",
        "uv_bringup 提供 sim_bringup / real_bringup / hil_bringup 三套编排",
        "workspace_auv 不依赖仿真，workspace_sim 以 colcon 覆盖层叠加",
        "visualization 为 PySide6 上位机：2D 地图、节点列表与遥控"
      ]
    }
  ]
