ROOT_DIR := ../..
BUILD_DIR := build
MAIN := main.tex
PDF := $(BUILD_DIR)/youlong-auv-manual.pdf
GIT_COMMIT := $(shell cd $(ROOT_DIR) && git rev-parse --short HEAD 2>/dev/null || echo unknown)
GIT_BRANCH := $(shell cd $(ROOT_DIR) && git branch --show-current 2>/dev/null || echo unknown)
GIT_TAG := $(shell cd $(ROOT_DIR) && git describe --tags --always --dirty 2>/dev/null || echo unknown)
BUILD_DATE := $(shell date +%F)

.PHONY: all pdf check clean

all: pdf

pdf: $(PDF)

$(BUILD_DIR)/git-info.tex:
	@mkdir -p $(BUILD_DIR)
	@printf '%% Generated by docs/latex/Makefile. Do not edit.\n' > $@
	@printf '\\newcommand{\\DocGitCommit}{$(GIT_COMMIT)}\n' >> $@
	@printf '\\newcommand{\\DocGitBranch}{$(GIT_BRANCH)}\n' >> $@
	@printf '\\newcommand{\\DocGitTag}{$(GIT_TAG)}\n' >> $@
	@printf '\\newcommand{\\DocBuildDate}{$(BUILD_DATE)}\n' >> $@

$(PDF): $(MAIN) preamble.tex $(BUILD_DIR)/git-info.tex $(shell find chapters appendices -type f -name '*.tex' 2>/dev/null) references.bib
	@mkdir -p $(BUILD_DIR)
	latexmk -xelatex -interaction=nonstopmode -halt-on-error -file-line-error \
		-outdir=$(BUILD_DIR) $(MAIN)
	@cp $(BUILD_DIR)/$(basename $(MAIN)).pdf $(PDF)

check: $(PDF)
	@test -s $(PDF)
	@command -v pdfinfo >/dev/null && pdfinfo $(PDF) >/dev/null
	@echo "LaTeX check passed: $(PDF)"

clean:
	@rm -rf $(BUILD_DIR)
