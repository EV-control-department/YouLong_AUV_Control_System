<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uv_stream</name>
  <version>0.1.0</version>
  <description>Display-only iceoryx2 camera streams and go2rtc integration.</description>
  <maintainer email="origin@example.com">origin</maintainer>
  <license>GPL-3.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>auv_protocol</exec_depend>
  <exec_depend>uv_image_transport</exec_depend>
  <exec_depend>uv_perception</exec_depend>
  <exec_depend>uv_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
