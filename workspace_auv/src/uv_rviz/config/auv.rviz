Panels:
  - Class: rviz_common/Displays
    Help Height: 80
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /TF1
        - /Stonefish vehicle model1
      Splitter Ratio: 0.5
    Tree Height: 650
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: NED XY Grid (X north, Y east)
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 1
      Name: NED odom axes (+Z down)
      Radius: 0.04
      Reference Frame: odom
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.55
      Name: FRD body axes (+X forward, +Y right, +Z down)
      Radius: 0.025
      Reference Frame: base_link
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.14
      Name: TF
      Show Arrows: true
      Show Axes: false
      Show Names: true
      Update Interval: 0.2
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ''
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auv/visualization/robot_description
      Enabled: true
      Name: Stonefish vehicle model
      TF Prefix: ''
      Update Interval: 0.1
      Value: true
      Visual Enabled: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 1
      Name: AUV odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.8
        Axes Radius: 0.08
        Head Length: 0.25
        Head Radius: 0.12
        Shaft Length: 0.55
        Shaft Radius: 0.05
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auv/visualization/odom
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Head Diameter: 0.18
      Head Length: 0.12
      Name: odom history
      Color: 40; 220; 90
      Shaft Diameter: 0.06
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auv/visualization/odom_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: perception measurements
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auv/visualization/measurements
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: perception tracks
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auv/visualization/tracks
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Head Diameter: 0.24
      Head Length: 0.16
      Name: planned path
      Color: 240; 60; 240
      Shaft Diameter: 0.09
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auv/visualization/planned_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 42; 42; 48
    Fixed Frame: odom
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.75
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.75
    Saved: ~
