+// Adapted from ros2/rosbag2 Foxy generic pub/sub for Foxglove Bridge 0.2.2.
+// Keep the type-support library alive until after the rcl entity is destroyed.
+#pragma once
+#include <rclcpp/rclcpp.hpp>
+#include <rosbag2_cpp/typesupport_helpers.hpp>
+
+namespace foxglove_bridge { namespace foxy {
+class TypeSupport {
+protected:
+  explicit TypeSupport(const std::string& type)
+    : library_(rosbag2_cpp::get_typesupport_library(type, "rosidl_typesupport_cpp")),
+      handle_(rosbag2_cpp::get_typesupport_handle(type, "rosidl_typesupport_cpp", library_)) {}
+  std::shared_ptr<rcpputils::SharedLibrary> library_;
+  const rosidl_message_type_support_t* handle_;
+};
+
+class GenericSubscription : private TypeSupport, public rclcpp::SubscriptionBase {
+public:
+  using SharedPtr = std::shared_ptr<GenericSubscription>;
+  using Callback = std::function<void(std::shared_ptr<rclcpp::SerializedMessage>)>;
+  GenericSubscription(rclcpp::Node& node, const std::string& topic, const std::string& type,
+                      const rclcpp::QoS& qos, Callback callback,
+                      const rclcpp::SubscriptionOptions& options)
+    : TypeSupport(type),
+      SubscriptionBase(node.get_node_base_interface().get(), *handle_, topic,
+                       subscription_options(qos), true),
+      callback_(std::move(callback)) {
+    if (options.event_callbacks.incompatible_qos_callback) {
+      try {
+        add_event_handler(options.event_callbacks.incompatible_qos_callback,
+                          RCL_SUBSCRIPTION_REQUESTED_INCOMPATIBLE_QOS);
+      } catch (const rclcpp::UnsupportedEventTypeException&) {
+        // Foxy's Fast DDS does not implement every QoS event.
+      }
+    }
+  }
+  std::shared_ptr<void> create_message() override { return create_serialized_message(); }
+  std::shared_ptr<rclcpp::SerializedMessage> create_serialized_message() override {
+    return std::make_shared<rclcpp::SerializedMessage>();
+  }
+  void handle_message(std::shared_ptr<void>& message, const rclcpp::MessageInfo&) override {
+    callback_(std::static_pointer_cast<rclcpp::SerializedMessage>(message));
+  }
+  void handle_loaned_message(void*, const rclcpp::MessageInfo&) override {
+    throw std::runtime_error("Foxy generic subscriptions do not support loaned messages");
+  }
+  void return_message(std::shared_ptr<void>& message) override { message.reset(); }
+  void return_serialized_message(std::shared_ptr<rclcpp::SerializedMessage>& message) override {
+    message.reset();
+  }
+private:
+  static rcl_subscription_options_t subscription_options(const rclcpp::QoS& qos) {
+    auto options = rcl_subscription_get_default_options();
+    options.qos = qos.get_rmw_qos_profile();
+    return options;
+  }
+  Callback callback_;
+};
+
+class GenericPublisher : private TypeSupport, public rclcpp::PublisherBase {
+public:
+  using SharedPtr = std::shared_ptr<GenericPublisher>;
+  GenericPublisher(rclcpp::Node& node, const std::string& topic, const std::string& type,
+                   const rclcpp::QoS& qos, const rclcpp::PublisherOptions&)
+    : TypeSupport(type),
+      PublisherBase(node.get_node_base_interface().get(), topic, *handle_,
+                    publisher_options(qos)) {}
+  void publish(const rclcpp::SerializedMessage& message) {
+    auto result = rcl_publish_serialized_message(get_publisher_handle().get(),
+                                                 &message.get_rcl_serialized_message(), nullptr);
+    if (result != RCL_RET_OK) {
+      rclcpp::exceptions::throw_from_rcl_error(result, "failed to publish serialized message");
+    }
+  }
+private:
+  static rcl_publisher_options_t publisher_options(const rclcpp::QoS& qos) {
+    auto options = rcl_publisher_get_default_options();
+    options.qos = qos.get_rmw_qos_profile();
+    return options;
+  }
+};
+}}  // namespace foxglove_bridge::foxy
