<?xml version="1.0"?>
<package format="3">
  <name>uv_sim</name>
  <version>0.1.0</version>
  <description>Simulation-only nodes for YouLong AUV</description>
  <maintainer email="origin@example.com">origin</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>stonefish_ros2</exec_depend>
  <exec_depend>zit6_interfaces</exec_depend>
  <!-- T5: mcu_control/odometry import numpy, pid_config imports yaml, and dvl_sim
       produces uv_msgs/Dvl.  Before T5 these were undeclared (registered as gap D3
       in docs/architecture/node_dependency.md; rosdep could not install them). -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>uv_msgs</exec_depend>
  <!-- laser_sim builds the laser stripe PointCloud2 with
       sensor_msgs_py.point_cloud2 (a separate package from sensor_msgs). -->
  <exec_depend>sensor_msgs_py</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
