# Horizontal AprilTag plate. Both caps carry UVs so the visible NED-up face is
# textured even when the mesh is viewed from a different camera direction.
v -0.110000 -0.110000 0.003000
v -0.110000 0.110000 0.003000
v 0.110000 0.110000 0.003000
v 0.110000 -0.110000 0.003000
v -0.110000 -0.110000 -0.003000
v -0.110000 0.110000 -0.003000
v 0.110000 0.110000 -0.003000
v 0.110000 -0.110000 -0.003000
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0
vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
s off
f 5/2/2 6/1/2 7/4/2
f 5/2/2 7/4/2 8/3/2
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 2//3 3//3 7//3
f 2//3 7//3 6//3
f 1//4 5//4 8//4
f 1//4 8//4 4//4
f 1//5 2//5 6//5
f 1//5 6//5 5//5
f 4//6 8//6 7//6
f 4//6 7//6 3//6
