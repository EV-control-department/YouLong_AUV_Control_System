<?xml version="1.0"?>
<scenario>
	<!--
	  中国机器人大赛暨 RoboCup 机器人世界杯中国赛 2026：机器人水中巡游。
	  Fixed training layout. NED coordinates: X in [0.0, 9.5], Y in [-2.25, 2.25],
	  water surface Z=0.0 and pool-floor top Z=1.30. The scene is visual/physical
	  training only: it contains no automatic scoring or grasping constraints.

		  Authoritative object table (metres; X is mirrored about the pool centre
		  so the configured Stonefish overhead view matches the rule sketch):
		    Start zone:              centre (8.95, -1.80), 0.80 x 0.80 at water surface
		    Impact balls:            Blue (8.95, 1.55, 0.70), Red (8.45, 1.55, 0.70)
		    Gates, low/high/low/high: (7.30, 0.80), (5.80, -0.40),
		                              (4.15, 0.85), (2.75, 1.15)
		    Target rack:             centre (0.95, -0.45, 1.00), 0.50 x 0.50
		    Collection frame:        centre (1.55, -1.65, 0.94), 0.40 x 0.30
	  The launcher supplies target_id as metadata (yellow_golf, pink_golf, red_ring);
	  all three acquisition targets intentionally remain visible in this scene.
	-->

	<environment>
		<ned latitude="40.0" longitude="3.0"/>
		<ocean>
			<!-- A calm pool with mild optical attenuation rather than ideal clear water. -->
			<water density="1000.0" jerlov="0.28"/>
			<waves height="0.0"/>
			<current type="uniform">
				<velocity xyz="0.0 0.0 0.0"/>
			</current>
		</ocean>
		<!-- Low sun elevation gives the cameras non-uniform lighting across the pool. -->
		<atmosphere>
			<sun azimuth="125.0" elevation="38.0" gain="2.8"/>
		</atmosphere>
	</environment>

	<materials>
		<material name="Neutral" density="1000.0" restitution="0.5"/>
		<material name="Concrete" density="2400.0" restitution="0.2"/>
		<material name="PVC" density="1380.0" restitution="0.3"/>
		<material name="Plastic" density="1100.0" restitution="0.3"/>
		<friction_table>
			<friction material1="Neutral" material2="Neutral" static="0.4" dynamic="0.2"/>
			<friction material1="Neutral" material2="Concrete" static="0.3" dynamic="0.2"/>
			<friction material1="Neutral" material2="PVC" static="0.4" dynamic="0.2"/>
			<friction material1="Neutral" material2="Plastic" static="0.4" dynamic="0.2"/>
			<friction material1="Concrete" material2="Concrete" static="0.8" dynamic="0.7"/>
			<friction material1="Concrete" material2="PVC" static="0.5" dynamic="0.4"/>
			<friction material1="Concrete" material2="Plastic" static="0.5" dynamic="0.4"/>
			<friction material1="PVC" material2="PVC" static="0.5" dynamic="0.4"/>
			<friction material1="PVC" material2="Plastic" static="0.5" dynamic="0.4"/>
			<friction material1="Plastic" material2="Plastic" static="0.5" dynamic="0.4"/>
		</friction_table>
	</materials>

	<looks>
		<!-- Same tiled pool background textures used by wuurc_murc_2026_auv.scn. -->
		<look name="pool_floor" gray="1.0" roughness="0.65" texture="guoshui_2026_pool_floor_tiled.png"/>
		<look name="pool_wall_long" gray="1.0" roughness="0.45" texture="guoshui_2026_pool_wall_long_tiled.png"/>
		<look name="pool_wall_side" gray="1.0" roughness="0.45" texture="guoshui_2026_pool_wall_side_tiled.png"/>
		<!-- Rule reference sample: orange-red guide line, sampled as approximately #C70102. -->
		<look name="guide_line" rgb="0.78 0.01 0.01" roughness="0.30"/>
		<look name="gate_red" rgb="0.92 0.03 0.03" roughness="0.30"/>
		<look name="gate_support" rgb="0.96 0.97 0.98" roughness="0.38"/>
		<look name="gate_sleeve_white" rgb="1.0 1.0 1.0" roughness="0.28"/>
		<look name="ball_blue" rgb="0.04 0.18 0.95" roughness="0.18"/>
		<look name="ball_red" rgb="0.95 0.04 0.04" roughness="0.18"/>
		<look name="golf_yellow" rgb="1.0 0.82 0.02" roughness="0.22"/>
		<look name="golf_pink" rgb="1.0 0.12 0.58" roughness="0.22"/>
		<look name="ring_red" rgb="0.90 0.02 0.02" roughness="0.25"/>
		<look name="ring_weight" rgb="0.12 0.12 0.14" roughness="0.65"/>
		<!-- White PVC target-rack frame and grid, matching the reference fixture. -->
		<look name="target_rack_white" rgb="0.95 0.97 1.0" roughness="0.35"/>
		<look name="target_rack_coupler" rgb="1.0 1.0 1.0" roughness="0.28"/>
		<look name="collection_red" rgb="1.0 0.04 0.02" roughness="0.28"/>
		<look name="collection_white" rgb="0.88 0.90 0.92" roughness="0.42"/>
		<look name="collection_coupler" rgb="1.0 1.0 1.0" roughness="0.28"/>
		<!-- White net strips are intentionally opaque and 6 mm wide for camera visibility. -->
		<!-- Bright white look keeps the thin net readable under the pool's directional shadow. -->
		<look name="collection_net" rgb="2.0 2.0 2.0" roughness="0.05"/>
		<look name="tether" rgb="0.08 0.08 0.08" roughness="0.70"/>
		<look name="start_marker" rgb="0.02 0.90 0.85" roughness="0.38"/>
	</looks>

	<!-- Pool: internal dimensions 9.50 x 4.50 x 1.30 m. -->
	<!-- uv_mode=2 keeps the external high-resolution tile texture aligned to pool dimensions. -->
	<static name="PoolBottom" type="box" uv_mode="2">
		<dimensions xyz="9.50 4.50 0.04"/>
		<material name="Concrete"/>
		<look name="pool_floor"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="4.75 0.0 1.32"/>
	</static>
	<static name="PoolWallNorth" type="box">
		<dimensions xyz="9.70 0.10 1.30"/>
		<material name="Concrete"/>
		<look name="pool_wall_long"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="4.75 2.30 0.65"/>
	</static>
	<static name="PoolWallSouth" type="box">
		<dimensions xyz="9.70 0.10 1.30"/>
		<material name="Concrete"/>
		<look name="pool_wall_long"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="4.75 -2.30 0.65"/>
	</static>
	<static name="PoolWallWest" type="box">
		<dimensions xyz="0.10 4.50 1.30"/>
		<material name="Concrete"/>
		<look name="pool_wall_side"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="-0.05 0.0 0.65"/>
	</static>
	<static name="PoolWallEast" type="box">
		<dimensions xyz="0.10 4.50 1.30"/>
		<material name="Concrete"/>
		<look name="pool_wall_side"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="9.55 0.0 0.65"/>
	</static>

	<!-- Simulator-only projection of the rule-defined 80 x 80 cm surface start zone. -->
	<static name="StartZoneNorth" type="box">
		<dimensions xyz="0.80 0.03 0.006"/>
		<material name="PVC"/><look name="start_marker"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="8.95 -1.40 1.293"/>
	</static>
	<static name="StartZoneSouth" type="box">
		<dimensions xyz="0.80 0.03 0.006"/>
		<material name="PVC"/><look name="start_marker"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="8.95 -2.20 1.293"/>
	</static>
	<static name="StartZoneEast" type="box">
		<dimensions xyz="0.03 0.80 0.006"/>
		<material name="PVC"/><look name="start_marker"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="8.55 -1.80 1.293"/>
	</static>
	<static name="StartZoneWest" type="box">
		<dimensions xyz="0.03 0.80 0.006"/>
		<material name="PVC"/><look name="start_marker"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="9.35 -1.80 1.293"/>
	</static>

	<!-- Exactly six 0.35 x 0.10 m guide lines.  Each one is at the geometric
	     midpoint of its two adjacent task centers and points from the earlier
	     task toward the next one.  There are intentionally no lines after the
	     target display rack. -->
	<static name="GuideStartToImpact" type="box"><dimensions xyz="0.35 0.10 0.008"/><material name="PVC"/><look name="guide_line"/><world_transform rpy="0.0 0.0 1.645285" xyz="8.825 -0.125 1.294"/></static>
	<static name="GuideImpactToGate1" type="box"><dimensions xyz="0.35 0.10 0.008"/><material name="PVC"/><look name="guide_line"/><world_transform rpy="0.0 0.0 -2.649783" xyz="8.000 1.175 1.294"/></static>
	<static name="GuideGate1ToGate2" type="box"><dimensions xyz="0.35 0.10 0.008"/><material name="PVC"/><look name="guide_line"/><world_transform rpy="0.0 0.0 -2.466852" xyz="6.550 0.200 1.294"/></static>
	<static name="GuideGate2ToGate3" type="box"><dimensions xyz="0.35 0.10 0.008"/><material name="PVC"/><look name="guide_line"/><world_transform rpy="0.0 0.0 2.493261" xyz="4.975 0.225 1.294"/></static>
	<static name="GuideGate3ToGate4" type="box"><dimensions xyz="0.35 0.10 0.008"/><material name="PVC"/><look name="guide_line"/><world_transform rpy="0.0 0.0 2.930499" xyz="3.450 1.000 1.294"/></static>
	<static name="GuideGate4ToTargetRack" type="box"><dimensions xyz="0.35 0.10 0.008"/><material name="PVC"/><look name="guide_line"/><world_transform rpy="0.0 0.0 -2.414950" xyz="1.850 0.350 1.294"/></static>

	<!-- Suspended impact targets. Cable world anchors are expressed in Stonefish's
	     cable frame, whose X direction is opposite to the mirrored scene layout. -->
	<dynamic name="ImpactBallBlue" type="sphere" physics="submerged" buoyant="true">
		<dimensions radius="0.10"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<material name="Neutral"/><look name="ball_blue"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="8.95 1.55 0.70"/>
	</dynamic>
	<dynamic name="ImpactBallRed" type="sphere" physics="submerged" buoyant="true">
		<dimensions radius="0.10"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<material name="Neutral"/><look name="ball_red"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="8.45 1.55 0.70"/>
	</dynamic>
	<!-- Visible fixed-length rope segments. Their X/Y exactly follow the mirrored balls.
	     These are static visual ropes because Stonefish's dynamic cable parser produces
	     an AABB overflow for this pair of submerged tethered spheres. -->
	<static name="ImpactBallBlueVisibleTether" type="cylinder">
		<dimensions radius="0.004" height="0.59"/>
		<material name="PVC"/><look name="tether"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="8.95 1.55 0.995"/>
	</static>
	<static name="ImpactBallRedVisibleTether" type="cylinder">
		<dimensions radius="0.004" height="0.59"/>
		<material name="PVC"/><look name="tether"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="8.45 1.55 0.995"/>
	</static>
	<!-- Four fixed 0.70 x 0.50 m gates.  They are split by visual class because
	     one Stonefish model node can carry only one look.  The positions and
	     dimensions are maintained in generate_guoshui_gate_parts.py. -->
	<static name="Guoshui2026GateRedPipes" type="model">
		<physical>
			<mesh filename="guoshui_2026_gate_red_pipes.obj" scale="1.0"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="PVC"/>
		<look name="gate_red"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</static>
	<static name="Guoshui2026GateWhiteSupports" type="model">
		<physical>
			<mesh filename="guoshui_2026_gate_white_supports.obj" scale="1.0"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="PVC"/>
		<look name="gate_support"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</static>
	<static name="Guoshui2026GateRedSleeves" type="model">
		<physical>
			<mesh filename="guoshui_2026_gate_red_sleeves.obj" scale="1.0"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="PVC"/>
		<look name="gate_red"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</static>
	<static name="Guoshui2026GateWhiteSleeves" type="model">
		<physical>
			<mesh filename="guoshui_2026_gate_white_sleeves.obj" scale="1.0"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="PVC"/>
		<look name="gate_sleeve_white"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</static>

	<!--
		Target display rack: 0.50 x 0.50 m overall, with its upper grid
		0.30 m above the pool bottom.  There is deliberately no solid shelf:
		four white PVC legs support a white perimeter frame and a regular
		diagonal wire grid, as in the rule-book illustration.
	-->
	<!-- Four white support legs; floor z=1.30, rack grid z=1.00. -->
	<static name="TargetRackLegNW" type="cylinder"><dimensions radius="0.015" height="0.30"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="0.0 0.0 0.0" xyz="1.17 -0.67 1.15"/></static>
	<static name="TargetRackLegNE" type="cylinder"><dimensions radius="0.015" height="0.30"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="0.0 0.0 0.0" xyz="0.73 -0.67 1.15"/></static>
	<static name="TargetRackLegSW" type="cylinder"><dimensions radius="0.015" height="0.30"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="0.0 0.0 0.0" xyz="1.17 -0.23 1.15"/></static>
	<static name="TargetRackLegSE" type="cylinder"><dimensions radius="0.015" height="0.30"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="0.0 0.0 0.0" xyz="0.73 -0.23 1.15"/></static>
	<!-- 8 mm outer PVC perimeter: x span=0.44 m, y span=0.44 m. -->
	<static name="TargetRackFrameNorth" type="cylinder"><dimensions radius="0.008" height="0.44"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="0.0 1.5708 0.0" xyz="0.95 -0.67 1.00"/></static>
	<static name="TargetRackFrameSouth" type="cylinder"><dimensions radius="0.008" height="0.44"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="0.0 1.5708 0.0" xyz="0.95 -0.23 1.00"/></static>
	<static name="TargetRackFrameWest" type="cylinder"><dimensions radius="0.008" height="0.44"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="1.5708 0.0 0.0" xyz="0.73 -0.45 1.00"/></static>
	<static name="TargetRackFrameEast" type="cylinder"><dimensions radius="0.008" height="0.44"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="1.5708 0.0 0.0" xyz="1.17 -0.45 1.00"/></static>
	<!-- Matching lower support frame on the pool floor; the dark floor remains visible through it. -->
	<static name="TargetRackBaseNorth" type="cylinder"><dimensions radius="0.008" height="0.44"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="0.0 1.5708 0.0" xyz="0.95 -0.67 1.294"/></static>
	<static name="TargetRackBaseSouth" type="cylinder"><dimensions radius="0.008" height="0.44"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="0.0 1.5708 0.0" xyz="0.95 -0.23 1.294"/></static>
	<static name="TargetRackBaseWest" type="cylinder"><dimensions radius="0.008" height="0.44"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="1.5708 0.0 0.0" xyz="0.73 -0.45 1.294"/></static>
	<static name="TargetRackBaseEast" type="cylinder"><dimensions radius="0.008" height="0.44"/><material name="PVC"/><look name="target_rack_white"/><world_transform rpy="1.5708 0.0 0.0" xyz="1.17 -0.45 1.294"/></static>
	<!-- Hollow PVC right-angle sleeves at the four upper pipe junctions. -->
	<static name="TargetRackTopSocketNWX" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 1.5708 0.0" xyz="1.145 -0.67 1.00"/></static>
	<static name="TargetRackTopSocketNWY" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="1.5708 0.0 0.0" xyz="1.17 -0.645 1.00"/></static>
	<static name="TargetRackTopSocketNEX" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 1.5708 0.0" xyz="0.755 -0.67 1.00"/></static>
	<static name="TargetRackTopSocketNEY" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="1.5708 0.0 0.0" xyz="0.73 -0.645 1.00"/></static>
	<static name="TargetRackTopSocketSWX" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 1.5708 0.0" xyz="1.145 -0.23 1.00"/></static>
	<static name="TargetRackTopSocketSWY" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="1.5708 0.0 0.0" xyz="1.17 -0.255 1.00"/></static>
	<static name="TargetRackTopSocketSEX" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 1.5708 0.0" xyz="0.755 -0.23 1.00"/></static>
	<static name="TargetRackTopSocketSEY" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="1.5708 0.0 0.0" xyz="0.73 -0.255 1.00"/></static>
	<static name="TargetRackTopSleeveNW" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 0.0 0.0" xyz="1.17 -0.67 1.00"/></static>
	<static name="TargetRackTopSleeveNE" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 0.0 0.0" xyz="0.73 -0.67 1.00"/></static>
	<static name="TargetRackTopSleeveSW" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 0.0 0.0" xyz="1.17 -0.23 1.00"/></static>
	<static name="TargetRackTopSleeveSE" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 0.0 0.0" xyz="0.73 -0.23 1.00"/></static>
	<!-- Hollow PVC right-angle sleeves at the four floor junctions. -->
	<static name="TargetRackBaseSocketNWX" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 1.5708 0.0" xyz="1.145 -0.67 1.294"/></static>
	<static name="TargetRackBaseSocketNWY" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="1.5708 0.0 0.0" xyz="1.17 -0.645 1.294"/></static>
	<static name="TargetRackBaseSocketNEX" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="0.0 1.5708 0.0" xyz="0.755 -0.67 1.294"/></static>
	<static name="TargetRackBaseSocketNEY" type="model"><physical><mesh filename="guoshui_2026_pvc_sleeve.obj" scale="1.0"/><origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/></physical><material name="PVC"/><look name="target_rack_coupler"/><world_transform rpy="1.5708 0.0 0.0" xyz="0.73 -0.645 1.294"/></static>
