		</trajectory>
	</animated>

	<!-- Bottom net: place the visual mesh and its collision plane on the lowest red rail. -->
	<animated name="CollectionNetVisual" type="model" collisions="true">
		<physical>
			<mesh filename="guoshui_2026_collection_collision_plane.obj" scale="1.0"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<visual>
			<mesh filename="guoshui_2026_collection_net_bottom_diagonal.obj" scale="1.0"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</visual>
		<material name="PVC"/><look name="collection_net"/>
		<trajectory type="spline" playback="repeat">
        <keypoint time="0.0" xyz="1.55 -1.65 1.10" rpy="0.0 0.0 0.0"/>
        <keypoint time="1.0" xyz="1.55 -1.65 1.10" rpy="0.0 0.0 0.0"/>
		</trajectory>
	</animated>

	<!-- Same six-thruster vehicle and ROS sensor interfaces as the previous default scenario. -->
	<include file="xunyun_fixed.scn">
		<arg name="robot_name" value="XUNYUN"/>
		<arg name="robot_position" value="8.95 -1.80 0.12"/>
		<!-- AUV 初始航向：相对原 180° 姿态逆时针旋转 90°，即 90°。 -->
		<arg name="robot_orientation" value="0.0 0.0 1.57079632679"/>
	</include>
</scenario>
