<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zit6_control_core</name>
  <version>0.1.0</version>
  <description>Host build of the ZIT6 firmware cascade controller (native C++ control core, exposed to Python via pybind11).</description>
  <maintainer email="exp-049@example.com">exp-049</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Native C++ control core depends on Eigen (system) + pybind11 (system apt python3-pybind11) -->
  <build_depend>eigen</build_depend>

  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
